# 前端依赖与构建产物（Vue 工程在 web/）
web/node_modules/
web/dist/

# npm 缓存：为避免占用 C 盘，已重定向到项目下
.npm-cache/
.npm-global/

# 小说项目工作区（用户的书稿与素材卡，按项目目录隔离，不入库）
projects/

# Python 缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# 编辑器/工具缓存
.workbuddy/
.idea/
.vscode/
*.log
.DS_Store

# 临时文件
*.txt
!requirements.txt

*.xml

# 会话持久化运行时文件（重启恢复用，不入库）
backend/checkpoints.pkl
backend/sessions.json
*.pkl
*.tmp